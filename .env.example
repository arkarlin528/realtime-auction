# Copy to .env and change every value. .env is git-ignored; never commit real secrets.

POSTGRES_PASSWORD=change-me-postgres

# 32+ random characters, e.g.:  openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-string-of-at-least-32-chars

# Password for the demo accounts (admin@ / bidder@ / bidder2@demo.test).
# Must match DEMO_PASSWORD in web/src/pages/LoginPage.tsx, which shows it to reviewers.
DEMO_PASSWORD=Demo#Auction2026

WEB_PORT=8081
